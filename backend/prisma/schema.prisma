// LV Transport Billing System — Prisma schema
//
// Conventions (see docs/ARCHITECTURE.md):
//   * Money      -> Decimal @db.Decimal(15, 2); never JS floats.
//   * Timestamps -> DateTime (stored as UTC).
//   * Business dates (trip date, expense date, payment date) -> DateTime @db.Date,
//     always interpreted as an Asia/Kolkata calendar date.
//   * Settlement months -> String @db.Char(7) in "YYYY-MM" format.
//
// Models are added phase by phase according to docs/DATABASE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// System-wide key/value settings (e.g. duplicate-detection defaults, tax config).
/// Value is JSON so settings can evolve without schema changes.
model Setting {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ============================================================
// Phase 2 — Identity, RBAC, audit
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
}

/// Exactly three roles (ADMIN, BILLER, AUDITOR), seeded from src/config/permissions.js.
model Role {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(30)
  name        String           @db.VarChar(60)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(60)
  module      String           @db.VarChar(40)
  description String           @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// One role per user (assumption A1). Role history is kept in audit_logs.
model User {
  id           Int        @id @default(autoincrement())
  name         String     @db.VarChar(100)
  email        String     @unique @db.VarChar(191)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  roleId       Int        @map("role_id")
  status       UserStatus @default(ACTIVE)
  /// Incremented to invalidate all existing sessions (password reset, deactivation).
  tokenVersion Int        @default(0) @map("token_version")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdById  Int?       @map("created_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  role         Role       @relation(fields: [roleId], references: [id])
  createdBy    User?      @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]     @relation("UserCreatedBy")
  auditLogs    AuditLog[]

  @@index([roleId])
  @@index([status])
  @@map("users")
}

/// Append-only audit trail. No update/delete API exists.
model AuditLog {
  id            Int      @id @default(autoincrement())
  userId        Int?     @map("user_id")
  action        String   @db.VarChar(40)
  entityType    String   @map("entity_type") @db.VarChar(50)
  entityId      String?  @map("entity_id") @db.VarChar(64)
  previousValue Json?    @map("previous_value")
  newValue      Json?    @map("new_value")
  reason        String?  @db.Text
  ip            String?  @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.VarChar(255)
  requestId     String?  @map("request_id") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
