// LV Transport Billing System — Prisma schema
//
// Conventions (see docs/ARCHITECTURE.md):
//   * Money      -> Decimal @db.Decimal(15, 2); never JS floats.
//   * Timestamps -> DateTime (stored as UTC).
//   * Business dates (trip date, expense date, payment date) -> DateTime @db.Date,
//     always interpreted as an Asia/Kolkata calendar date.
//   * Settlement months -> String @db.Char(7) in "YYYY-MM" format.
//
// Models are added phase by phase according to docs/DATABASE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// System-wide key/value settings (e.g. duplicate-detection defaults, tax config).
/// Value is JSON so settings can evolve without schema changes.
model Setting {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ============================================================
// Phase 2 — Identity, RBAC, audit
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
}

/// Exactly three roles (ADMIN, BILLER, AUDITOR), seeded from src/config/permissions.js.
model Role {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(30)
  name        String           @db.VarChar(60)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(60)
  module      String           @db.VarChar(40)
  description String           @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// One role per user (assumption A1). Role history is kept in audit_logs.
model User {
  id           Int        @id @default(autoincrement())
  name         String     @db.VarChar(100)
  email        String     @unique @db.VarChar(191)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  roleId       Int        @map("role_id")
  status       UserStatus @default(ACTIVE)
  /// Incremented to invalidate all existing sessions (password reset, deactivation).
  tokenVersion Int        @default(0) @map("token_version")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdById  Int?       @map("created_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  role         Role       @relation(fields: [roleId], references: [id])
  createdBy    User?      @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]     @relation("UserCreatedBy")
  auditLogs    AuditLog[]

  companiesCreated           Company[]                  @relation("CompanyCreatedBy")
  driversCreated             Driver[]                   @relation("DriverCreatedBy")
  vehicleTypesCreated        VehicleType[]              @relation("VehicleTypeCreatedBy")
  ratesCreated               VehicleTypeRate[]          @relation("RateCreatedBy")
  ratesCancelled             VehicleTypeRate[]          @relation("RateCancelledBy")
  vehiclesCreated            Vehicle[]                  @relation("VehicleCreatedBy")
  vehicleAssignmentsCreated  VehicleAssignment[]        @relation("VehicleAssignmentCreatedBy")
  driverAssignmentsCreated   DriverAssignment[]         @relation("DriverAssignmentCreatedBy")
  companySettlementsCreated  CompanySettlement[]        @relation("CompanySettlementCreatedBy")
  companySettlementsReceived CompanySettlement[]        @relation("CompanySettlementReceivedBy")
  tripsCreated               Trip[]                     @relation("TripCreatedBy")
  tripsUpdated               Trip[]                     @relation("TripUpdatedBy")
  tripsCancelled             Trip[]                     @relation("TripCancelledBy")
  importTemplatesCreated     ImportTemplate[]           @relation("ImportTemplateCreatedBy")
  importsUploaded            TripImport[]               @relation("ImportUploadedBy")
  importsImported            TripImport[]               @relation("ImportImportedBy")
  earningsCreated            DriverEarning[]            @relation("EarningCreatedBy")
  earningsVoided             DriverEarning[]            @relation("EarningVoidedBy")
  adjustmentsCreated         DriverAdjustment[]         @relation("AdjustmentCreatedBy")
  adjustmentsVoided          DriverAdjustment[]         @relation("AdjustmentVoidedBy")
  expensesCreated            DriverExpense[]            @relation("ExpenseCreatedBy")
  expensesVoided             DriverExpense[]            @relation("ExpenseVoidedBy")
  advancesCreated            DriverAdvance[]            @relation("AdvanceCreatedBy")
  advancesVoided             DriverAdvance[]            @relation("AdvanceVoidedBy")
  recoveriesCreated          AdvanceRecovery[]          @relation("RecoveryCreatedBy")
  recoveriesVoided           AdvanceRecovery[]          @relation("RecoveryVoidedBy")
  settlementsCreated         DriverSettlement[]         @relation("SettlementCreatedBy")
  settlementsCalculated      DriverSettlement[]         @relation("SettlementCalculatedBy")
  settlementsSubmitted       DriverSettlement[]         @relation("SettlementSubmittedBy")
  settlementsApproved        DriverSettlement[]         @relation("SettlementApprovedBy")
  settlementsFinalized       DriverSettlement[]         @relation("SettlementFinalizedBy")
  settlementRevisions        DriverSettlementRevision[] @relation("SettlementReopenedBy")
  paymentsCreated            DriverPayment[]            @relation("PaymentCreatedBy")
  paymentsReversed           DriverPayment[]            @relation("PaymentReversedBy")
  taxRatesCreated            TaxRateConfig[]            @relation("TaxRateCreatedBy")
  gstCreated                 GstRecord[]                @relation("GstCreatedBy")
  gstVoided                  GstRecord[]                @relation("GstVoidedBy")

  @@index([roleId])
  @@index([status])
  @@map("users")
}

/// Append-only audit trail. No update/delete API exists.
model AuditLog {
  id            Int      @id @default(autoincrement())
  userId        Int?     @map("user_id")
  action        String   @db.VarChar(40)
  entityType    String   @map("entity_type") @db.VarChar(50)
  entityId      String?  @map("entity_id") @db.VarChar(64)
  previousValue Json?    @map("previous_value")
  newValue      Json?    @map("new_value")
  reason        String?  @db.Text
  ip            String?  @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.VarChar(255)
  requestId     String?  @map("request_id") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// Phase 3 — Master data
// ============================================================

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum RateStatus {
  ACTIVE
  CANCELLED
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
  HYBRID
  LPG
  OTHER
}

/// Corporate client. Name is unique; code is an optional short unique key.
model Company {
  id            Int          @id @default(autoincrement())
  code          String?      @unique @db.VarChar(20)
  name          String       @unique @db.VarChar(150)
  contactPerson String?      @map("contact_person") @db.VarChar(100)
  phone         String?      @db.VarChar(20)
  email         String?      @db.VarChar(191)
  address       String?      @db.Text
  gstin         String?      @db.VarChar(15)
  status        RecordStatus @default(ACTIVE)
  notes         String?      @db.Text
  createdById   Int?         @map("created_by_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  createdBy          User?                        @relation("CompanyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  vehicleAssignments VehicleAssignment[]
  settlements        CompanySettlement[]
  trips              Trip[]
  importTemplates    ImportTemplate[]
  allocations        DriverSettlementAllocation[]
  gstRecords         GstRecord[]
  tripImports        TripImport[]

  @@index([status])
  @@map("companies")
}

model Driver {
  id                Int          @id @default(autoincrement())
  driverCode        String       @unique @map("driver_code") @db.VarChar(20)
  fullName          String       @map("full_name") @db.VarChar(100)
  phone             String       @db.VarChar(15)
  alternatePhone    String?      @map("alternate_phone") @db.VarChar(15)
  address           String?      @db.Text
  joiningDate       DateTime?    @map("joining_date") @db.Date
  licenseNumber     String?      @unique @map("license_number") @db.VarChar(30)
  licenseExpiryDate DateTime?    @map("license_expiry_date") @db.Date
  status            RecordStatus @default(ACTIVE)
  bankAccountName   String?      @map("bank_account_name") @db.VarChar(100)
  bankAccountNumber String?      @map("bank_account_number") @db.VarChar(30)
  bankIfsc          String?      @map("bank_ifsc") @db.VarChar(11)
  bankName          String?      @map("bank_name") @db.VarChar(100)
  upiId             String?      @map("upi_id") @db.VarChar(100)
  notes             String?      @db.Text
  createdById       Int?         @map("created_by_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  createdBy   User?              @relation("DriverCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignments DriverAssignment[]
  trips       Trip[]
  earnings    DriverEarning[]
  adjustments DriverAdjustment[]
  expenses    DriverExpense[]
  advances    DriverAdvance[]
  recoveries  AdvanceRecovery[]
  settlements DriverSettlement[]
  payments    DriverPayment[]

  @@index([status])
  @@index([fullName])
  @@index([phone])
  @@map("drivers")
}

/// Trip rates are defined per vehicle type (spec 13), not per vehicle.
model VehicleType {
  id          Int          @id @default(autoincrement())
  name        String       @unique @db.VarChar(50)
  description String?      @db.VarChar(255)
  status      RecordStatus @default(ACTIVE)
  createdById Int?         @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  createdBy User?             @relation("VehicleTypeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  rates     VehicleTypeRate[]
  vehicles  Vehicle[]

  trips Trip[]

  @@map("vehicle_types")
}

/// Append-only rate history. Active periods for a type never overlap (enforced in
/// rates.service under a row lock). Values are never edited; mistakes are CANCELLED.
model VehicleTypeRate {
  id            Int        @id @default(autoincrement())
  vehicleTypeId Int        @map("vehicle_type_id")
  ratePerKm     Decimal    @map("rate_per_km") @db.Decimal(10, 2)
  effectiveFrom DateTime   @map("effective_from") @db.Date
  effectiveTo   DateTime?  @map("effective_to") @db.Date
  status        RateStatus @default(ACTIVE)
  notes         String?    @db.VarChar(255)
  cancelReason  String?    @map("cancel_reason") @db.VarChar(255)
  cancelledAt   DateTime?  @map("cancelled_at")
  cancelledById Int?       @map("cancelled_by_id")
  createdById   Int?       @map("created_by_id")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)
  createdBy   User?       @relation("RateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy User?       @relation("RateCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  trips       Trip[]

  @@index([vehicleTypeId, status, effectiveFrom])
  @@map("vehicle_type_rates")
}

model Vehicle {
  id                       Int          @id @default(autoincrement())
  /// Normalized: upper-case, no spaces or hyphens (e.g. KA01AB1234).
  registrationNumber       String       @unique @map("registration_number") @db.VarChar(20)
  vehicleTypeId            Int          @map("vehicle_type_id")
  make                     String?      @db.VarChar(50)
  model                    String?      @db.VarChar(50)
  year                     Int?         @db.SmallInt
  fuelType                 FuelType?    @map("fuel_type")
  status                   RecordStatus @default(ACTIVE)
  insuranceProvider        String?      @map("insurance_provider") @db.VarChar(100)
  insurancePolicyNumber    String?      @map("insurance_policy_number") @db.VarChar(50)
  insuranceExpiryDate      DateTime?    @map("insurance_expiry_date") @db.Date
  fitnessCertificateNumber String?      @map("fitness_certificate_number") @db.VarChar(50)
  fitnessExpiryDate        DateTime?    @map("fitness_expiry_date") @db.Date
  permitNumber             String?      @map("permit_number") @db.VarChar(50)
  permitExpiryDate         DateTime?    @map("permit_expiry_date") @db.Date
  notes                    String?      @db.Text
  createdById              Int?         @map("created_by_id")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")

  vehicleType        VehicleType         @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)
  createdBy          User?               @relation("VehicleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  companyAssignments VehicleAssignment[]
  driverAssignments  DriverAssignment[]
  expenses           DriverExpense[]

  trips Trip[]

  @@index([vehicleTypeId])
  @@index([status])
  @@map("vehicles")
}

/// Which company a vehicle serves, over time (endDate NULL = open-ended).
model VehicleAssignment {
  id          Int       @id @default(autoincrement())
  vehicleId   Int       @map("vehicle_id")
  companyId   Int       @map("company_id")
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  notes       String?   @db.VarChar(255)
  createdById Int?      @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy User?   @relation("VehicleAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([vehicleId, startDate])
  @@index([companyId, startDate])
  @@map("vehicle_assignments")
}

/// Which vehicle a driver drives, over time (endDate NULL = open-ended).
model DriverAssignment {
  id          Int       @id @default(autoincrement())
  driverId    Int       @map("driver_id")
  vehicleId   Int       @map("vehicle_id")
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  notes       String?   @db.VarChar(255)
  createdById Int?      @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  driver    Driver  @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  createdBy User?   @relation("DriverAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([driverId, startDate])
  @@index([vehicleId, startDate])
  @@map("driver_assignments")
}

// ============================================================
// Phase 4 — Monthly company settlement
// ============================================================

/// Spec §20: only these four methods are allowed in V1.
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
}

enum CompanySettlementStatus {
  PENDING
  RECEIVED
}

/// One record per company per month (spec §18). Only RECEIVED amounts count as
/// actual cash received for LV profit. Expected and received amounts are both kept.
model CompanySettlement {
  id              Int                     @id @default(autoincrement())
  companyId       Int                     @map("company_id")
  /// "YYYY-MM"
  settlementMonth String                  @map("settlement_month") @db.Char(7)
  expectedAmount  Decimal                 @map("expected_amount") @db.Decimal(15, 2)
  receivedAmount  Decimal?                @map("received_amount") @db.Decimal(15, 2)
  status          CompanySettlementStatus @default(PENDING)
  receivedDate    DateTime?               @map("received_date") @db.Date
  paymentMethod   PaymentMethod?          @map("payment_method")
  referenceNumber String?                 @map("reference_number") @db.VarChar(100)
  notes           String?                 @db.Text
  createdById     Int?                    @map("created_by_id")
  receivedById    Int?                    @map("received_by_id")
  receivedAt      DateTime?               @map("received_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  company    Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy  User?   @relation("CompanySettlementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  receivedBy User?   @relation("CompanySettlementReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  @@unique([companyId, settlementMonth])
  @@index([settlementMonth])
  @@index([status])
  @@map("company_settlements")
}

// ============================================================
// Phase 5 — Trips
// ============================================================

/// How total KM was obtained (spec §16).
enum KmSource {
  START_END
  DIRECT
}

enum TripSource {
  MANUAL
  IMPORT
}

enum TripStatus {
  ACTIVE
  CANCELLED
}

/// A trip, priced as TOTAL KM × the vehicle type's rate on the trip date (spec §17).
/// The vehicle type, rate row and rate value used are stored on the trip so historical
/// earnings never change when rates change; only an explicit, audited recalculation does.
model Trip {
  id              Int        @id @default(autoincrement())
  companyId       Int        @map("company_id")
  driverId        Int        @map("driver_id")
  vehicleId       Int        @map("vehicle_id")
  /// Snapshot of the vehicle's type when the trip was priced.
  vehicleTypeId   Int        @map("vehicle_type_id")
  tripDate        DateTime   @map("trip_date") @db.Date
  /// "YYYY-MM", derived from tripDate.
  settlementMonth String     @map("settlement_month") @db.Char(7)
  /// Company's own trip id; unique per company when present.
  externalTripId  String?    @map("external_trip_id") @db.VarChar(100)
  tripReference   String?    @map("trip_reference") @db.VarChar(100)
  pickup          String?    @db.VarChar(255)
  dropLocation    String?    @map("drop_location") @db.VarChar(255)
  startKm         Decimal?   @map("start_km") @db.Decimal(12, 2)
  endKm           Decimal?   @map("end_km") @db.Decimal(12, 2)
  totalKm         Decimal    @map("total_km") @db.Decimal(12, 2)
  kmSource        KmSource   @map("km_source")
  rateId          Int        @map("rate_id")
  ratePerKm       Decimal    @map("rate_per_km") @db.Decimal(10, 2)
  earnings        Decimal    @db.Decimal(15, 2)
  source          TripSource @default(MANUAL)
  /// Import batch (FK added with the bulk-import module in Phase 6).
  importId        Int?       @map("import_id")
  status          TripStatus @default(ACTIVE)
  cancelReason    String?    @map("cancel_reason") @db.VarChar(500)
  cancelledAt     DateTime?  @map("cancelled_at")
  cancelledById   Int?       @map("cancelled_by_id")
  notes           String?    @db.Text
  /// Extensible company-specific fields (e.g. unmapped import columns).
  extra           Json?
  createdById     Int?       @map("created_by_id")
  updatedById     Int?       @map("updated_by_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  driver      Driver          @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicle     Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  vehicleType VehicleType     @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)
  rate        VehicleTypeRate @relation(fields: [rateId], references: [id], onDelete: Restrict)
  createdBy   User?           @relation("TripCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?           @relation("TripUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  cancelledBy User?           @relation("TripCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  import      TripImport?     @relation(fields: [importId], references: [id], onDelete: Restrict)

  @@unique([companyId, externalTripId])
  @@index([companyId, tripDate])
  @@index([driverId, tripDate])
  @@index([vehicleId, tripDate])
  @@index([tripDate])
  @@index([settlementMonth, driverId])
  @@index([status])
  @@index([rateId])
  @@index([importId])
  @@map("trips")
}

// ============================================================
// Phase 6 — Bulk trip import
// ============================================================

enum DriverMatchField {
  CODE
  LICENSE
  PHONE
  NAME
}

enum ImportStatus {
  VALIDATED
  IMPORTED
  DISCARDED
  FAILED
}

enum ImportRowStatus {
  VALID
  WARNING
  ERROR
  DUPLICATE
  IMPORTED
}

/// Company-specific, reusable import template (spec §39). Nothing about a company's
/// file layout is hard-coded: headers, date format, KM method, driver matching and the
/// duplicate key are all configured here.
model ImportTemplate {
  id               Int              @id @default(autoincrement())
  companyId        Int              @map("company_id")
  name             String           @db.VarChar(100)
  /// One of the supported date patterns, e.g. "DD/MM/YYYY".
  dateFormat       String           @map("date_format") @db.VarChar(20)
  kmMode           KmSource         @map("km_mode")
  driverMatchField DriverMatchField @default(CODE) @map("driver_match_field")
  /// Ordered field names forming the duplicate key, e.g. ["externalTripId"].
  duplicateKey     Json             @map("duplicate_key")
  /// Keep unmapped columns in trips.extra.
  keepUnmapped     Boolean          @default(true) @map("keep_unmapped")
  status           RecordStatus     @default(ACTIVE)
  createdById      Int?             @map("created_by_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  company   Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy User?                   @relation("ImportTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  mappings  ImportTemplateMapping[]
  imports   TripImport[]

  @@unique([companyId, name])
  @@map("import_templates")
}

/// Source column header → system field.
model ImportTemplateMapping {
  id           Int    @id @default(autoincrement())
  templateId   Int    @map("template_id")
  sourceColumn String @map("source_column") @db.VarChar(150)
  targetField  String @map("target_field") @db.VarChar(40)

  template ImportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, targetField])
  @@map("import_template_mappings")
}

/// One uploaded file (import batch) and its outcome (spec §42).
model TripImport {
  id               Int          @id @default(autoincrement())
  companyId        Int          @map("company_id")
  templateId       Int?         @map("template_id")
  fileName         String       @map("file_name") @db.VarChar(255)
  fileSize         Int          @map("file_size")
  fileHash         String       @map("file_hash") @db.Char(64)
  /// Template settings and mappings as used for this batch.
  templateSnapshot Json         @map("template_snapshot")
  status           ImportStatus @default(VALIDATED)
  totalRows        Int          @default(0) @map("total_rows")
  validRows        Int          @default(0) @map("valid_rows")
  warningRows      Int          @default(0) @map("warning_rows")
  errorRows        Int          @default(0) @map("error_rows")
  duplicateRows    Int          @default(0) @map("duplicate_rows")
  importedRows     Int          @default(0) @map("imported_rows")
  errorDetails     String?      @map("error_details") @db.Text
  uploadedById     Int?         @map("uploaded_by_id")
  importedById     Int?         @map("imported_by_id")
  importedAt       DateTime?    @map("imported_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  template   ImportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  uploadedBy User?           @relation("ImportUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  importedBy User?           @relation("ImportImportedBy", fields: [importedById], references: [id], onDelete: SetNull)
  rows       ImportRow[]
  trips      Trip[]

  @@index([companyId, createdAt])
  @@index([status])
  @@index([fileHash])
  @@map("trip_imports")
}

/// Every source row with its raw values, normalized values, status and messages.
model ImportRow {
  id         Int             @id @default(autoincrement())
  importId   Int             @map("import_id")
  rowNumber  Int             @map("row_number")
  raw        Json
  normalized Json?
  status     ImportRowStatus
  /// [{ level: "error"|"warning"|"duplicate", field?, message }]
  messages   Json
  tripId     Int?            @map("trip_id")

  import TripImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, rowNumber])
  @@index([importId, status])
  @@map("import_rows")
}

// ============================================================
// Phase 7 — Driver earnings (allowances, other earnings, adjustments)
// ============================================================

enum EarningType {
  ALLOWANCE
  OTHER_EARNING
}

/// POSITIVE_ADJUSTMENT adds to the settlement; OTHER_DEDUCTION (Phase 8) subtracts.
enum AdjustmentType {
  POSITIVE_ADJUSTMENT
  OTHER_DEDUCTION
}

enum ItemStatus {
  ACTIVE
  VOID
}

/// Allowances and other earnings — each a separate line item (spec §21).
model DriverEarning {
  id              Int         @id @default(autoincrement())
  driverId        Int         @map("driver_id")
  type            EarningType
  amount          Decimal     @db.Decimal(15, 2)
  earningDate     DateTime    @map("earning_date") @db.Date
  /// "YYYY-MM": the monthly settlement this item belongs to.
  settlementMonth String      @map("settlement_month") @db.Char(7)
  description     String      @db.VarChar(500)
  status          ItemStatus  @default(ACTIVE)
  voidReason      String?     @map("void_reason") @db.VarChar(500)
  voidedAt        DateTime?   @map("voided_at")
  voidedById      Int?        @map("voided_by_id")
  createdById     Int?        @map("created_by_id")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  driver    Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)
  createdBy User?  @relation("EarningCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  voidedBy  User?  @relation("EarningVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)

  @@index([driverId, settlementMonth])
  @@index([settlementMonth, status])
  @@index([earningDate])
  @@map("driver_earnings")
}

/// Positive adjustments and other deductions; a reason is mandatory (spec §26).
model DriverAdjustment {
  id              Int            @id @default(autoincrement())
  driverId        Int            @map("driver_id")
  type            AdjustmentType
  amount          Decimal        @db.Decimal(15, 2)
  adjustmentDate  DateTime       @map("adjustment_date") @db.Date
  settlementMonth String         @map("settlement_month") @db.Char(7)
  reason          String         @db.VarChar(500)
  status          ItemStatus     @default(ACTIVE)
  voidReason      String?        @map("void_reason") @db.VarChar(500)
  voidedAt        DateTime?      @map("voided_at")
  voidedById      Int?           @map("voided_by_id")
  createdById     Int?           @map("created_by_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  driver    Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)
  createdBy User?  @relation("AdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  voidedBy  User?  @relation("AdjustmentVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)

  @@index([driverId, settlementMonth])
  @@index([settlementMonth, status])
  @@index([adjustmentDate])
  @@map("driver_adjustments")
}

// ============================================================
// Phase 8 — Expenses and advances
// ============================================================

/// Who paid (spec §24): LV-paid is DEDUCTED from the driver settlement,
/// driver-paid is REIMBURSED (added).
enum ExpensePaidBy {
  LV
  DRIVER
}

/// LV-paid: FUEL, TOLL, MAINTENANCE, EMI. Driver-paid: FUEL, TOLL, MAINTENANCE, OTHER.
enum ExpenseCategory {
  FUEL
  TOLL
  MAINTENANCE
  EMI
  OTHER
}

enum AdvanceStatus {
  OPEN
  RECOVERED
  VOID
}

model DriverExpense {
  id               Int             @id @default(autoincrement())
  driverId         Int             @map("driver_id")
  vehicleId        Int             @map("vehicle_id")
  paidBy           ExpensePaidBy   @map("paid_by")
  category         ExpenseCategory
  amount           Decimal         @db.Decimal(15, 2)
  expenseDate      DateTime        @map("expense_date") @db.Date
  settlementMonth  String          @map("settlement_month") @db.Char(7)
  description      String          @db.VarChar(500)
  /// Bill / receipt number until document upload arrives (Phase 15).
  receiptReference String?         @map("receipt_reference") @db.VarChar(100)
  status           ItemStatus      @default(ACTIVE)
  voidReason       String?         @map("void_reason") @db.VarChar(500)
  voidedAt         DateTime?       @map("voided_at")
  voidedById       Int?            @map("voided_by_id")
  createdById      Int?            @map("created_by_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  driver    Driver  @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  createdBy User?   @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  voidedBy  User?   @relation("ExpenseVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)

  @@index([driverId, settlementMonth])
  @@index([vehicleId, expenseDate])
  @@index([expenseDate])
  @@index([settlementMonth, paidBy, category, status])
  @@map("driver_expenses")
}

/// Money already paid to a driver, recovered through later settlements (spec §25).
/// recoveredAmount + outstandingAmount = amount, maintained under a row lock.
model DriverAdvance {
  id                Int           @id @default(autoincrement())
  driverId          Int           @map("driver_id")
  amount            Decimal       @db.Decimal(15, 2)
  advanceDate       DateTime      @map("advance_date") @db.Date
  reason            String        @db.VarChar(500)
  paymentMethod     PaymentMethod @map("payment_method")
  referenceNumber   String?       @map("reference_number") @db.VarChar(100)
  recoveredAmount   Decimal       @default(0) @map("recovered_amount") @db.Decimal(15, 2)
  outstandingAmount Decimal       @map("outstanding_amount") @db.Decimal(15, 2)
  status            AdvanceStatus @default(OPEN)
  voidReason        String?       @map("void_reason") @db.VarChar(500)
  voidedAt          DateTime?     @map("voided_at")
  voidedById        Int?          @map("voided_by_id")
  createdById       Int?          @map("created_by_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  driver     Driver            @relation(fields: [driverId], references: [id], onDelete: Restrict)
  createdBy  User?             @relation("AdvanceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  voidedBy   User?             @relation("AdvanceVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  recoveries AdvanceRecovery[]

  @@index([driverId, status])
  @@index([advanceDate])
  @@map("driver_advances")
}

/// One recovery of an advance in a settlement month (partial recovery supported).
model AdvanceRecovery {
  id              Int        @id @default(autoincrement())
  advanceId       Int        @map("advance_id")
  driverId        Int        @map("driver_id")
  settlementMonth String     @map("settlement_month") @db.Char(7)
  amount          Decimal    @db.Decimal(15, 2)
  recoveryDate    DateTime   @map("recovery_date") @db.Date
  notes           String?    @db.VarChar(500)
  status          ItemStatus @default(ACTIVE)
  voidReason      String?    @map("void_reason") @db.VarChar(500)
  voidedAt        DateTime?  @map("voided_at")
  voidedById      Int?       @map("voided_by_id")
  createdById     Int?       @map("created_by_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  advance   DriverAdvance @relation(fields: [advanceId], references: [id], onDelete: Restrict)
  driver    Driver        @relation(fields: [driverId], references: [id], onDelete: Restrict)
  createdBy User?         @relation("RecoveryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  voidedBy  User?         @relation("RecoveryVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)

  @@index([advanceId])
  @@index([driverId, settlementMonth])
  @@map("advance_recoveries")
}

// ============================================================
// Phase 9 — Driver settlement engine
// ============================================================

enum SettlementStatus {
  DRAFT
  CALCULATED
  UNDER_REVIEW
  APPROVED
  FINALIZED
}

/// Payment status applies once a settlement is FINALIZED (assumption A2).
enum SettlementPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum SettlementComponent {
  TRIP_EARNINGS
  ALLOWANCE
  OTHER_EARNING
  POSITIVE_ADJUSTMENT
  REIMBURSEMENT
  FUEL
  TOLL
  MAINTENANCE
  EMI
  ADVANCE_RECOVERY
  OTHER_DEDUCTION
}

enum SettlementDirection {
  ADD
  DEDUCT
}

/// Monthly driver settlement (spec §27–31). One per driver per month. Component totals
/// and the final amount are stored exactly as calculated by settlement-formula.js.
model DriverSettlement {
  id                  Int                      @id @default(autoincrement())
  driverId            Int                      @map("driver_id")
  settlementMonth     String                   @map("settlement_month") @db.Char(7)
  status              SettlementStatus         @default(DRAFT)
  paymentStatus       SettlementPaymentStatus? @map("payment_status")
  tripEarnings        Decimal                  @default(0) @map("trip_earnings") @db.Decimal(15, 2)
  allowances          Decimal                  @default(0) @db.Decimal(15, 2)
  otherEarnings       Decimal                  @default(0) @map("other_earnings") @db.Decimal(15, 2)
  positiveAdjustments Decimal                  @default(0) @map("positive_adjustments") @db.Decimal(15, 2)
  reimbursements      Decimal                  @default(0) @db.Decimal(15, 2)
  fuel                Decimal                  @default(0) @db.Decimal(15, 2)
  toll                Decimal                  @default(0) @db.Decimal(15, 2)
  maintenance         Decimal                  @default(0) @db.Decimal(15, 2)
  emi                 Decimal                  @default(0) @db.Decimal(15, 2)
  advanceRecovery     Decimal                  @default(0) @map("advance_recovery") @db.Decimal(15, 2)
  otherDeductions     Decimal                  @default(0) @map("other_deductions") @db.Decimal(15, 2)
  grossEarnings       Decimal                  @default(0) @map("gross_earnings") @db.Decimal(15, 2)
  totalAdditions      Decimal                  @default(0) @map("total_additions") @db.Decimal(15, 2)
  totalDeductions     Decimal                  @default(0) @map("total_deductions") @db.Decimal(15, 2)
  finalAmount         Decimal                  @default(0) @map("final_amount") @db.Decimal(15, 2)
  /// Sum of VALID driver payments (Phase 10).
  paidAmount          Decimal                  @default(0) @map("paid_amount") @db.Decimal(15, 2)
  itemCount           Int                      @default(0) @map("item_count")
  /// SHA-256 of the calculated items; detects stale calculations.
  calculationHash     String?                  @map("calculation_hash") @db.Char(64)
  version             Int                      @default(1)
  reopenCount         Int                      @default(0) @map("reopen_count")
  notes               String?                  @db.Text
  calculatedAt        DateTime?                @map("calculated_at")
  calculatedById      Int?                     @map("calculated_by_id")
  submittedAt         DateTime?                @map("submitted_at")
  submittedById       Int?                     @map("submitted_by_id")
  approvedAt          DateTime?                @map("approved_at")
  approvedById        Int?                     @map("approved_by_id")
  finalizedAt         DateTime?                @map("finalized_at")
  finalizedById       Int?                     @map("finalized_by_id")
  createdById         Int?                     @map("created_by_id")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  driver       Driver                       @relation(fields: [driverId], references: [id], onDelete: Restrict)
  createdBy    User?                        @relation("SettlementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  calculatedBy User?                        @relation("SettlementCalculatedBy", fields: [calculatedById], references: [id], onDelete: SetNull)
  submittedBy  User?                        @relation("SettlementSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  approvedBy   User?                        @relation("SettlementApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  finalizedBy  User?                        @relation("SettlementFinalizedBy", fields: [finalizedById], references: [id], onDelete: SetNull)
  items        DriverSettlementItem[]
  revisions    DriverSettlementRevision[]
  payments     DriverPayment[]
  allocations  DriverSettlementAllocation[]

  @@unique([driverId, settlementMonth])
  @@index([settlementMonth, status])
  @@index([status])
  @@map("driver_settlements")
}

/// One line per source row included in the calculation (transparent breakdown, §63).
model DriverSettlementItem {
  id           Int                 @id @default(autoincrement())
  settlementId Int                 @map("settlement_id")
  component    SettlementComponent
  direction    SettlementDirection
  /// TRIP | DRIVER_EARNING | ADJUSTMENT | EXPENSE | ADVANCE_RECOVERY
  sourceType   String              @map("source_type") @db.VarChar(30)
  sourceId     Int                 @map("source_id")
  sourceDate   DateTime?           @map("source_date") @db.Date
  description  String              @db.VarChar(500)
  amount       Decimal             @db.Decimal(15, 2)

  settlement DriverSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId, component])
  @@index([sourceType, sourceId])
  @@map("driver_settlement_items")
}

/// Snapshot of a FINALIZED settlement taken when it is reopened (spec §31).
model DriverSettlementRevision {
  id           Int      @id @default(autoincrement())
  settlementId Int      @map("settlement_id")
  version      Int
  snapshot     Json
  reason       String   @db.Text
  reopenedById Int?     @map("reopened_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  settlement DriverSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  reopenedBy User?            @relation("SettlementReopenedBy", fields: [reopenedById], references: [id], onDelete: SetNull)

  @@unique([settlementId, version])
  @@map("driver_settlement_revisions")
}

// ============================================================
// Phase 10 — Driver payments
// ============================================================

enum PaymentRecordStatus {
  VALID
  REVERSED
}

/// A payment against a FINALIZED settlement (spec §32–33). Immutable once recorded;
/// corrected only by reversal. Outstanding = final settlement − Σ VALID payments.
model DriverPayment {
  id              Int                 @id @default(autoincrement())
  settlementId    Int                 @map("settlement_id")
  driverId        Int                 @map("driver_id")
  amount          Decimal             @db.Decimal(15, 2)
  paymentDate     DateTime            @map("payment_date") @db.Date
  paymentMethod   PaymentMethod       @map("payment_method")
  referenceNumber String?             @map("reference_number") @db.VarChar(100)
  notes           String?             @db.VarChar(500)
  /// Proof reference until document upload arrives (Phase 15).
  proofReference  String?             @map("proof_reference") @db.VarChar(255)
  status          PaymentRecordStatus @default(VALID)
  reversalReason  String?             @map("reversal_reason") @db.VarChar(500)
  reversedAt      DateTime?           @map("reversed_at")
  reversedById    Int?                @map("reversed_by_id")
  createdById     Int?                @map("created_by_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  settlement DriverSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  driver     Driver           @relation(fields: [driverId], references: [id], onDelete: Restrict)
  createdBy  User?            @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reversedBy User?            @relation("PaymentReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)

  @@index([settlementId, status])
  @@index([driverId, paymentDate])
  @@index([paymentDate])
  @@map("driver_payments")
}

// ============================================================
// Phase 11 — LV profit
// ============================================================

/// Share of a FINALIZED driver settlement attributed to a company (assumption A7:
/// proportional to the driver's trip earnings per company that month). companyId NULL
/// holds the part that cannot be attributed (driver had no trips that month).
/// Rows are replaced on every finalization and removed on reopen.
model DriverSettlementAllocation {
  id              Int      @id @default(autoincrement())
  settlementId    Int      @map("settlement_id")
  companyId       Int?     @map("company_id")
  /// Denormalized for fast profit queries.
  settlementMonth String   @map("settlement_month") @db.Char(7)
  tripEarnings    Decimal  @map("trip_earnings") @db.Decimal(15, 2)
  amount          Decimal  @db.Decimal(15, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  settlement DriverSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  company    Company?         @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([settlementId, companyId])
  @@index([settlementMonth, companyId])
  @@map("driver_settlement_allocations")
}

// ============================================================
// Phase 14 — GST / tax (reporting and preparation only)
// ============================================================

enum GstDirection {
  OUTWARD
  INWARD
}

enum GstSupplyType {
  INTRA_STATE
  INTER_STATE
}

/// Configurable GST rates by HSN/SAC (spec §52: never hard-coded). Effective-dated.
model TaxRateConfig {
  id            Int          @id @default(autoincrement())
  hsnSac        String       @map("hsn_sac") @db.VarChar(10)
  description   String       @db.VarChar(255)
  /// Total GST rate in percent (split CGST/SGST for intra-state, IGST inter-state).
  gstRate       Decimal      @map("gst_rate") @db.Decimal(5, 2)
  cessRate      Decimal      @default(0) @map("cess_rate") @db.Decimal(5, 2)
  effectiveFrom DateTime     @map("effective_from") @db.Date
  effectiveTo   DateTime?    @map("effective_to") @db.Date
  status        RecordStatus @default(ACTIVE)
  createdById   Int?         @map("created_by_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  createdBy User?       @relation("TaxRateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  records   GstRecord[]

  @@index([hsnSac, effectiveFrom])
  @@map("tax_rate_configs")
}

/// Invoice-level GST record. OUTWARD = LV's tax invoices; INWARD = purchases/expenses.
/// Tax amounts are computed by gst-calculations.js from taxable value, rate and supply type.
model GstRecord {
  id                Int           @id @default(autoincrement())
  direction         GstDirection
  companyId         Int?          @map("company_id")
  counterpartyName  String        @map("counterparty_name") @db.VarChar(150)
  counterpartyGstin String?       @map("counterparty_gstin") @db.VarChar(15)
  /// GSTIN or "" — makes (direction, counterpartyKey, invoiceNumber) unique.
  counterpartyKey   String        @default("") @map("counterparty_key") @db.VarChar(15)
  invoiceNumber     String        @map("invoice_number") @db.VarChar(50)
  invoiceDate       DateTime      @map("invoice_date") @db.Date
  /// "YYYY-MM" return period.
  taxPeriod         String        @map("tax_period") @db.Char(7)
  hsnSac            String        @map("hsn_sac") @db.VarChar(10)
  description       String?       @db.VarChar(255)
  taxableValue      Decimal       @map("taxable_value") @db.Decimal(15, 2)
  taxRate           Decimal       @map("tax_rate") @db.Decimal(5, 2)
  cessRate          Decimal       @default(0) @map("cess_rate") @db.Decimal(5, 2)
  supplyType        GstSupplyType @map("supply_type")
  /// 2-digit state code of the place of supply.
  placeOfSupply     String        @map("place_of_supply") @db.Char(2)
  reverseCharge     Boolean       @default(false) @map("reverse_charge")
  cgst              Decimal       @db.Decimal(15, 2)
  sgst              Decimal       @db.Decimal(15, 2)
  igst              Decimal       @db.Decimal(15, 2)
  cess              Decimal       @db.Decimal(15, 2)
  totalTax          Decimal       @map("total_tax") @db.Decimal(15, 2)
  invoiceValue      Decimal       @map("invoice_value") @db.Decimal(15, 2)
  taxRateConfigId   Int?          @map("tax_rate_config_id")
  notes             String?       @db.Text
  status            ItemStatus    @default(ACTIVE)
  voidReason        String?       @map("void_reason") @db.VarChar(500)
  voidedAt          DateTime?     @map("voided_at")
  voidedById        Int?          @map("voided_by_id")
  createdById       Int?          @map("created_by_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  company       Company?       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  taxRateConfig TaxRateConfig? @relation(fields: [taxRateConfigId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("GstCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  voidedBy      User?          @relation("GstVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)

  @@unique([direction, counterpartyKey, invoiceNumber])
  @@index([taxPeriod, direction, status])
  @@index([companyId, taxPeriod])
  @@index([hsnSac])
  @@map("gst_records")
}
