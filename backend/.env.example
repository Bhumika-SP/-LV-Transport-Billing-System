# ---------------------------------------------------------------
# LV Transport Billing System — backend environment
# Copy to backend/.env and fill in real values. Never commit .env.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=4000

# MySQL connection (Prisma). Use a dedicated app user, not root.
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://lv_app:change_me@localhost:3306/lv_billing"

# Comma-separated list of allowed browser origins (frontend URLs)
CORS_ORIGINS=http://localhost:5173

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
# Session length in hours (cookie and JWT expiry)
SESSION_HOURS=8
# lax (recommended: same-origin via Vercel rewrite) | strict | none (cross-site; requires secure)
COOKIE_SAMESITE=lax
# Defaults to true in production
# COOKIE_SECURE=true
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# --- Development seed (npm run db:seed) ---
# Password for the three development users. Leave unset to skip creating them.
SEED_USER_PASSWORD=
