# ---------------------------------------------------------------
# LV Transport Billing System — frontend environment
# Only VITE_* variables are exposed to the browser. NEVER put secrets here.
# ---------------------------------------------------------------

# Base URL for API calls. Leave as "/api" when the frontend host proxies/rewrites
# /api to the backend (recommended: keeps auth cookies first-party).
VITE_API_BASE_URL=/api

# Dev server only: where Vite proxies /api and /health.
VITE_DEV_API_PROXY=http://localhost:4000
